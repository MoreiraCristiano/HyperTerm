<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:HyperTerm.UI.Services">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#252526" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D30" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#252526" />
          <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
          <SolidColorBrush x:Key="BorderHoverBrush" Color="#5A5A5E" />
          <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
          <SolidColorBrush x:Key="HoverBrush" Color="#2A2D2E" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#252526" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#094771" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#D4D4D4" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9D9D" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F14C4C" />
          <SolidColorBrush x:Key="WarningBrush" Color="#CCA700" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#4EC9B0" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
          <SolidColorBrush x:Key="SidebarScrollBarHoverBrush" Color="#484848" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static services:ApplicationThemeVariants.Darcula}">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#313335" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#313335" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#313335" />
          <SolidColorBrush x:Key="BorderBrush" Color="#808080" Opacity="0.55" />
          <SolidColorBrush x:Key="BorderHoverBrush" Color="#808080" Opacity="0.90" />
          <SolidColorBrush x:Key="AccentBrush" Color="#6897BB" />
          <SolidColorBrush x:Key="HoverBrush" Color="#323232" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#313335" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#214283" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#A9B7C6" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#808080" />
          <SolidColorBrush x:Key="DangerBrush" Color="#CC7832" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FFC66D" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#6A8759" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
          <SolidColorBrush x:Key="SidebarScrollBarHoverBrush" Color="#808080" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#E9E9E9" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E9E9E9" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D1D1D1" />
          <SolidColorBrush x:Key="BorderHoverBrush" Color="#A6A6A6" />
          <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
          <SolidColorBrush x:Key="HoverBrush" Color="#E1E1E1" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5F5F5F" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
          <SolidColorBrush x:Key="SidebarScrollBarHoverBrush" Color="#A0A0A0" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <FontFamily x:Key="AppFontFamily">Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHero">28</x:Double>

    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
    <Thickness x:Key="ControlPadding">12,7</Thickness>
    <Thickness x:Key="CompactControlPadding">8,5</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <x:Double x:Key="DialogContentSpacing">16</x:Double>
    <x:Double x:Key="DialogButtonSpacing">8</x:Double>
    <Thickness x:Key="TreeItemPadding">0</Thickness>
    <Thickness x:Key="SessionTreeMargin">4,0,0,0</Thickness>
    <Thickness x:Key="TreeItemContentMargin">0</Thickness>
    <Thickness x:Key="TreeItemEndpointMargin">8,0,0,0</Thickness>
    <Thickness x:Key="TreeItemIconMargin">0,0,6,0</Thickness>
    <x:Double x:Key="TreeItemMinHeight">28</x:Double>
    <x:Double x:Key="TreeItemIconSize">13</x:Double>
    <x:Double x:Key="TreeItemIconWidth">16</x:Double>
    <x:Double x:Key="SidebarMinWidth">180</x:Double>
    <x:Double x:Key="SidebarMaxWidth">480</x:Double>
    <GridLength x:Key="SidebarDefaultWidth">240</GridLength>
    <GridLength x:Key="SidebarSplitterWidth">4</GridLength>
    <x:Double x:Key="SidebarSectionHeaderHeight">24</x:Double>
    <x:Double x:Key="SidebarActionSpacing">6</x:Double>
    <Thickness x:Key="SidebarActionLeadingMargin">6,0,0,0</Thickness>
    <x:Double x:Key="SettingsDialogMaxWidth">1040</x:Double>
    <Thickness x:Key="SettingsDialogMargin">24</Thickness>
    <x:Double x:Key="TerminalTabMinWidth">190</x:Double>
    <Thickness x:Key="TerminalTabClosePadding">7,2</Thickness>
    <x:Double x:Key="TitleBarHeight">42</x:Double>
    <x:Double x:Key="TitleBarSettingsWidth">42</x:Double>
    <x:Double x:Key="NewTerminalActionWidth">28</x:Double>
    <x:Double x:Key="CaptionButtonWidth">46</x:Double>
    <x:Double x:Key="CaptionButtonIconSize">10</x:Double>
    <GridLength x:Key="WindowResizeGripSize">5</GridLength>
    <x:Double x:Key="SettingsSectionSpacing">12</x:Double>
    <Thickness x:Key="SettingsBodyMargin">0,20,0,16</Thickness>
    <Thickness x:Key="SettingsContentMargin">24,0,0,0</Thickness>
    <Thickness x:Key="SettingsSectionPadding">16</Thickness>
    <Thickness x:Key="SettingsSectionDescriptionMargin">0,3,0,12</Thickness>
    <Thickness x:Key="SettingsLabelMargin">0,0,0,5</Thickness>
    <Thickness x:Key="SettingsNestedFieldMargin">0,12,0,0</Thickness>
    <Thickness x:Key="SettingsBrowseButtonMargin">8,0,0,0</Thickness>
    <Thickness x:Key="SettingsFooterPadding">0,16,0,0</Thickness>
    <Thickness x:Key="SettingsStatusMargin">0,10,0,0</Thickness>
    <Thickness x:Key="ColorSwatchMargin">0,0,8,0</Thickness>
    <x:Double x:Key="SettingsActionSpacing">8</x:Double>
    <x:Double x:Key="SettingsIndexWidth">120</x:Double>
    <x:Double x:Key="SettingsTabMinHeight">28</x:Double>
    <x:Double x:Key="SettingsGroupTitleFontSize">16</x:Double>
    <x:Double x:Key="SettingsColorPickerWidth">220</x:Double>
    <x:Double x:Key="ColorSwatchSize">14</x:Double>
    <CornerRadius x:Key="RadiusS">3</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">8</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.icon">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.buttonIcon">
    <Setter Property="RenderTransform">
      <TranslateTransform Y="2" />
    </Setter>
  </Style>
  <Style Selector="Button TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tabCloseButton">
    <Setter Property="Padding" Value="{DynamicResource TerminalTabClosePadding}" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Button.tabCloseButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.tabCloseButton:pointerover /template/ ContentPresenter, Button.tabCloseButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="Button.titleBarButton, Button.captionButton">
    <Setter Property="Height" Value="{DynamicResource TitleBarHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.titleBarButton">
    <Setter Property="Width" Value="{DynamicResource TitleBarSettingsWidth}" />
  </Style>
  <Style Selector="Button.newTerminalPrimaryButton">
    <Setter Property="Width" Value="{DynamicResource NewTerminalActionWidth}" />
  </Style>
  <Style Selector="Button.newTerminalMenuButton">
    <Setter Property="Width" Value="{DynamicResource NewTerminalActionWidth}" />
  </Style>
  <Style Selector="Button.newTerminalPrimaryButton /template/ ContentPresenter, Button.newTerminalMenuButton /template/ ContentPresenter">
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="Button.newTerminalPrimaryButton /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="3,0,0,3" />
  </Style>
  <Style Selector="Button.newTerminalMenuButton /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="0,3,3,0" />
  </Style>
  <Style Selector="Button.captionButton">
    <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
  </Style>
  <Style Selector="Button.captionButton TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CaptionButtonIconSize}" />
  </Style>
  <Style Selector="Button.closeCaptionButton:pointerover /template/ ContentPresenter, Button.closeCaptionButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource TreeItemMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource CompactControlPadding}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="TextBox, NumericUpDown, ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
  </Style>
  <Style Selector="TextBox:pointerover, NumericUpDown:pointerover, ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border, NumericUpDown:pointerover /template/ Border, ComboBox:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
  </Style>
  <Style Selector="TextBox:focus, NumericUpDown:focus, ComboBox:focus">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border, NumericUpDown:focus /template/ Border, ComboBox:focus /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot, ListBoxItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource TreeItemMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource TreeItemPadding}" />
    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
  </Style>
  <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
  </Style>
  <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TextBlock.sessionTreeFolder">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.sessionTreeRow">
    <Setter Property="Margin" Value="{DynamicResource TreeItemContentMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource TreeItemMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="Grid.sessionTreeRow.batchSelected">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="TextBlock.sessionTreeEmpty">
    <Setter Property="Margin" Value="{DynamicResource TreeItemEndpointMargin}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.sessionTreeIcon">
    <Setter Property="Width" Value="{DynamicResource TreeItemIconWidth}" />
    <Setter Property="Margin" Value="{DynamicResource TreeItemIconMargin}" />
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource TreeItemIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot, ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot, ListBoxItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="TreeView.sessionsTree ScrollBar:vertical">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MaxWidth" Value="6" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Effect" Value="{x:Null}" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TreeView.sessionsTree TreeViewItem">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>
  <Style Selector="TreeView.sessionsTree ScrollBar:vertical /template/ Thumb">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinWidth" Value="4" />
    <Setter Property="MaxWidth" Value="4" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>
  <Style Selector="TreeView.sessionsTree ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource SidebarScrollBarHoverBrush}" />
  </Style>
  <Style Selector="TreeView.sessionsTree ScrollBar:vertical:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TreeViewItem.dropTarget /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem.tabDropBefore /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="ListBoxItem.tabDropAfter /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,2,0" />
  </Style>
  <Style Selector="GridSplitter.sidebarSplitter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="GridSplitter.sidebarSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled">
    <Setter Property="Opacity" Value="0.40" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled ListBox.terminalTabs > ListBoxItem /template/ Border#PART_LayoutRoot,
                   ScrollViewer.tabArea:disabled ListBox.terminalTabs > ListBoxItem:pointerover /template/ Border#PART_LayoutRoot,
                   ScrollViewer.tabArea:disabled ListBox.terminalTabs > ListBoxItem:selected /template/ Border#PART_LayoutRoot,
                   ScrollViewer.tabArea:disabled ListBox.terminalTabs > ListBoxItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled Button.newTerminalPrimaryButton,
                   ScrollViewer.tabArea:disabled Button.newTerminalMenuButton">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled Button.newTerminalPrimaryButton /template/ ContentPresenter,
                   ScrollViewer.tabArea:disabled Button.newTerminalMenuButton /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled Button.tabCloseButton">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
  </Style>
  <Style Selector="ScrollViewer.tabArea:disabled Button.tabCloseButton /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
  </Style>
  <Style Selector="Border.settingsSection">
    <Setter Property="Padding" Value="{DynamicResource SettingsSectionPadding}" />
    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>
  <Style Selector="ScrollViewer.settingsContent">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="TabControl.settingsTabs">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TabItem.settingsTab">
    <Setter Property="Width" Value="{DynamicResource SettingsIndexWidth}" />
    <Setter Property="Height" Value="{DynamicResource SettingsTabMinHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="TabItem.settingsTab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TabItem.settingsTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="TabItem.settingsTab:selected">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="TabItem.settingsTab:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.themePicker">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="ListBox.themePicker > ListBoxItem">
    <Setter Property="MinWidth" Value="360" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>
  <Style Selector="ListBox.themePicker > ListBoxItem:pointerover /template/ Border#PART_LayoutRoot,
                   ListBox.themePicker > ListBoxItem:selected /template/ Border#PART_LayoutRoot,
                   ListBox.themePicker > ListBoxItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
  </Style>
  <Style Selector="TextBlock.settingsGroupTitle">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="FontSize" Value="{DynamicResource SettingsGroupTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settingsSectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settingsSectionDescription">
    <Setter Property="Margin" Value="{DynamicResource SettingsSectionDescriptionMargin}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.settingsLabel">
    <Setter Property="Margin" Value="{DynamicResource SettingsLabelMargin}" />
  </Style>
  <Style Selector="TextBlock.shortcutGroupTitle">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Grid.shortcutList > TextBlock">
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.shortcutList > TextBlock.shortcutGesture">
    <Setter Property="Margin" Value="24,3,0,3" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
</Styles>
