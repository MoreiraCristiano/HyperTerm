<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="ColorBackground">#1E1E1E</Color>
    <Color x:Key="ColorBackgroundSecondary">#252526</Color>
    <Color x:Key="ColorPanel">#2D2D30</Color>
    <Color x:Key="ColorBorder">#3C3C3C</Color>
    <Color x:Key="ColorAccent">#007ACC</Color>
    <Color x:Key="ColorHover">#2A2D2E</Color>
    <Color x:Key="ColorSelection">#094771</Color>
    <Color x:Key="ColorTextPrimary">#D4D4D4</Color>
    <Color x:Key="ColorTextSecondary">#9D9D9D</Color>
    <Color x:Key="ColorError">#F14C4C</Color>
    <Color x:Key="ColorWarning">#CCA700</Color>
    <Color x:Key="ColorSuccess">#4EC9B0</Color>
    <Color x:Key="ColorOverlay">#B3000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource ColorBackgroundSecondary}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource ColorBackgroundSecondary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource ColorSelection}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource ColorOverlay}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <FontFamily x:Key="AppFontFamily">Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHero">28</x:Double>

    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
    <Thickness x:Key="ControlPadding">12,7</Thickness>
    <Thickness x:Key="CompactControlPadding">8,5</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <Thickness x:Key="TreeItemPadding">0</Thickness>
    <Thickness x:Key="SessionTreeMargin">4,0,0,0</Thickness>
    <Thickness x:Key="TreeItemContentMargin">0</Thickness>
    <Thickness x:Key="TreeSessionContentMargin">16,0,6,0</Thickness>
    <Thickness x:Key="TreeItemEndpointMargin">8,0,0,0</Thickness>
    <Thickness x:Key="TreeItemIconMargin">0,0,6,0</Thickness>
    <x:Double x:Key="TreeItemMinHeight">28</x:Double>
    <x:Double x:Key="TreeItemIconSize">13</x:Double>
    <x:Double x:Key="TreeItemIconWidth">16</x:Double>
    <x:Double x:Key="SidebarMinWidth">180</x:Double>
    <x:Double x:Key="SidebarMaxWidth">480</x:Double>
    <GridLength x:Key="SidebarDefaultWidth">240</GridLength>
    <GridLength x:Key="SidebarSplitterWidth">4</GridLength>
    <x:Double x:Key="SidebarSectionHeaderHeight">24</x:Double>
    <x:Double x:Key="SidebarActionSpacing">6</x:Double>
    <Thickness x:Key="SidebarActionLeadingMargin">6,0,0,0</Thickness>
    <x:Double x:Key="SettingsDialogWidth">680</x:Double>
    <x:Double x:Key="SettingsDialogMaxHeight">720</x:Double>
    <x:Double x:Key="TerminalTabMinWidth">190</x:Double>
    <Thickness x:Key="TerminalTabClosePadding">7,2</Thickness>
    <x:Double x:Key="TitleBarHeight">42</x:Double>
    <x:Double x:Key="TitleBarIdentityWidth">240</x:Double>
    <Thickness x:Key="TitleBarIdentityPadding">12,0</Thickness>
    <x:Double x:Key="TitleBarSettingsWidth">42</x:Double>
    <x:Double x:Key="CaptionButtonWidth">46</x:Double>
    <x:Double x:Key="CaptionButtonIconSize">10</x:Double>
    <GridLength x:Key="WindowResizeGripSize">5</GridLength>
    <x:Double x:Key="SettingsSectionSpacing">12</x:Double>
    <Thickness x:Key="SettingsBodyMargin">0,20,0,16</Thickness>
    <Thickness x:Key="SettingsSectionPadding">16</Thickness>
    <Thickness x:Key="SettingsSectionDescriptionMargin">0,3,0,12</Thickness>
    <Thickness x:Key="SettingsLabelMargin">0,0,0,5</Thickness>
    <Thickness x:Key="SettingsNestedFieldMargin">0,12,0,0</Thickness>
    <Thickness x:Key="SettingsBrowseButtonMargin">8,0,0,0</Thickness>
    <Thickness x:Key="SettingsFooterPadding">0,16,0,0</Thickness>
    <Thickness x:Key="SettingsStatusMargin">0,10,0,0</Thickness>
    <Thickness x:Key="ColorSwatchMargin">0,0,8,0</Thickness>
    <x:Double x:Key="SettingsActionSpacing">8</x:Double>
    <x:Double x:Key="SettingsColorPickerWidth">220</x:Double>
    <x:Double x:Key="ColorSwatchSize">14</x:Double>
    <CornerRadius x:Key="RadiusS">3</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">8</CornerRadius>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.icon">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.buttonIcon">
    <Setter Property="RenderTransform">
      <TranslateTransform Y="2" />
    </Setter>
  </Style>
  <Style Selector="Button TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tabCloseButton">
    <Setter Property="Padding" Value="{DynamicResource TerminalTabClosePadding}" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Button.tabCloseButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.tabCloseButton:pointerover /template/ ContentPresenter, Button.tabCloseButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="Button.titleBarButton, Button.captionButton">
    <Setter Property="Height" Value="{DynamicResource TitleBarHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.titleBarButton">
    <Setter Property="Width" Value="{DynamicResource TitleBarSettingsWidth}" />
  </Style>
  <Style Selector="Button.captionButton">
    <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
  </Style>
  <Style Selector="Button.captionButton TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CaptionButtonIconSize}" />
  </Style>
  <Style Selector="Button.closeCaptionButton:pointerover /template/ ContentPresenter, Button.closeCaptionButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBox, NumericUpDown, ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border, NumericUpDown:focus /template/ Border, ComboBox:focus /template/ Border">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot, ListBoxItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource TreeItemMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource TreeItemPadding}" />
    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
  </Style>
  <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
  </Style>
  <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TextBlock.sessionTreeFolder">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.sessionTreeRow">
    <Setter Property="Margin" Value="{DynamicResource TreeItemContentMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource TreeItemMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  </Style>
  <Style Selector="Grid.sessionTreeRow.batchSelected">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="Grid.sessionTreeRow.nestedSession">
    <Setter Property="Margin" Value="{DynamicResource TreeSessionContentMargin}" />
  </Style>
  <Style Selector="TextBlock.sessionTreeEndpoint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.sessionTreeIcon">
    <Setter Property="Width" Value="{DynamicResource TreeItemIconWidth}" />
    <Setter Property="Margin" Value="{DynamicResource TreeItemIconMargin}" />
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource TreeItemIconSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot, ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot, ListBoxItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="TreeViewItem.dropTarget /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="GridSplitter.sidebarSplitter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="GridSplitter.sidebarSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.settingsSection">
    <Setter Property="Padding" Value="{DynamicResource SettingsSectionPadding}" />
    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>
  <Style Selector="TextBlock.settingsSectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settingsSectionDescription">
    <Setter Property="Margin" Value="{DynamicResource SettingsSectionDescriptionMargin}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.settingsLabel">
    <Setter Property="Margin" Value="{DynamicResource SettingsLabelMargin}" />
  </Style>
</Styles>
