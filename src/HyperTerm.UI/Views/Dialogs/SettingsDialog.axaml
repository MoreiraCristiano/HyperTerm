<UserControl
    x:Name="SettingsRoot"
    x:Class="HyperTerm.UI.Views.Dialogs.SettingsDialog"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:HyperTerm.UI.ViewModels"
    IsVisible="{Binding Settings.IsSettingsOpen}">
  <UserControl.Resources>
    <DataTemplate x:Key="ThemeOptionTemplate" x:DataType="viewModels:ThemeOption">
      <Grid Margin="12" ColumnDefinitions="64,*">
        <Border
            Width="52"
            Height="34"
            VerticalAlignment="Center"
            Background="{Binding PreviewBackground}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="4">
          <Grid RowDefinitions="8,*">
            <Border Background="{Binding PreviewHeader}" CornerRadius="3,3,0,0" />
            <Border Grid.Row="1" Width="12" HorizontalAlignment="Left" Background="{Binding PreviewSidebar}" CornerRadius="0,0,0,3" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
          <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Panel>
    <Border Background="{DynamicResource OverlayBrush}" />
    <Border
        MaxWidth="{DynamicResource SettingsDialogMaxWidth}"
        Margin="{DynamicResource SettingsDialogMargin}"
        Padding="{DynamicResource DialogPadding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusL}">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel>
          <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Text="Settings" />
          <TextBlock Classes="secondary" Text="Configure HyperTerm, terminal appearance, data, and diagnostics." />
        </StackPanel>

        <TabControl
            x:Name="SettingsTabs"
            Grid.Row="1"
            Margin="{DynamicResource SettingsBodyMargin}"
            Classes="settingsTabs"
            HorizontalContentAlignment="Stretch"
            TabStripPlacement="Left"
            VerticalContentAlignment="Stretch">
          <TabItem Classes="settingsTab" Header="General">
            <ScrollViewer Margin="{DynamicResource SettingsContentMargin}" Classes="settingsContent">
              <StackPanel x:Name="GeneralGroup">
                <TextBlock Classes="settingsGroupTitle" Text="General" />
                <StackPanel Spacing="{DynamicResource SettingsSectionSpacing}">
                  <Border Classes="settingsSection">
                    <StackPanel>
                      <TextBlock Classes="settingsSectionTitle" Text="Interface" />
                      <TextBlock Classes="settingsSectionDescription" Text="Control workspace visibility and window behavior." />
                      <StackPanel Spacing="{DynamicResource SettingsActionSpacing}">
                        <CheckBox IsChecked="{Binding Settings.SettingsShowSidebarScrollbar, Mode=TwoWay}" Content="Show sidebar scrollbar" />
                        <CheckBox IsChecked="{Binding Settings.SettingsCloseToSystemTray, Mode=TwoWay}" Content="Keep HyperTerm running in the system tray when the window closes" />
                        <CheckBox IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" Content="Show status bar" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="settingsSection">
                    <StackPanel>
                      <TextBlock Classes="settingsSectionTitle" Text="psmux" />
                      <TextBlock Classes="settingsSectionDescription" Text="Enable persistent terminal sessions managed by psmux." />
                      <CheckBox IsChecked="{Binding Settings.SettingsPsmuxEnabled, Mode=TwoWay}" Content="Enable psmux integration" />
                      <StackPanel Margin="0,8,0,0" IsVisible="{Binding Settings.SettingsPsmuxEnabled}">
                        <CheckBox IsChecked="{Binding Settings.SettingsKeepPsmuxSessionsOnExit, Mode=TwoWay}" Content="Keep psmux sessions running after HyperTerm closes" />
                        <TextBlock Margin="0,8,0,0" Classes="secondary" Text="Turning this off ends every detached session in HyperTerm’s psmux namespace when the application exits. Sessions attached by another client are preserved." TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Classes="settingsTab" Header="Themes">
            <ScrollViewer Margin="{DynamicResource SettingsContentMargin}" Classes="settingsContent">
              <StackPanel x:Name="ThemesGroup">
                <TextBlock Classes="settingsGroupTitle" Text="Themes" />
                <Border Classes="settingsSection">
                  <StackPanel>
                    <TextBlock Classes="settingsSectionTitle" Text="Application theme" />
                    <TextBlock Classes="settingsSectionDescription" Text="Choose the appearance used throughout HyperTerm." />
                    <Grid x:Name="ThemeColumns" ColumnDefinitions="*,16,*">
                      <StackPanel>
                        <TextBlock Margin="0,4,0,8" Classes="themeGroupTitle" Text="Dark themes" />
                        <ListBox
                            x:Name="ThemePicker"
                            Classes="themePicker"
                            ItemTemplate="{StaticResource ThemeOptionTemplate}"
                            ItemsSource="{Binding Settings.DarkThemeOptions}"
                            SelectedItem="{Binding Settings.SelectedDarkTheme, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,4,0,8" Classes="themeGroupTitle" Text="Light themes" />
                        <ListBox
                            x:Name="LightThemePicker"
                            Classes="themePicker"
                            ItemTemplate="{StaticResource ThemeOptionTemplate}"
                            ItemsSource="{Binding Settings.LightThemeOptions}"
                            SelectedItem="{Binding Settings.SelectedLightTheme, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Classes="settingsTab" Header="Profiles">
            <Grid
                x:Name="ProfilesGroup"
                Margin="{DynamicResource SettingsContentMargin}"
                RowDefinitions="Auto,12,*">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Margin="0,0,0,2" Classes="settingsGroupTitle" Text="Profiles" />
                  <TextBlock Classes="secondary" Text="Choose the default terminal or configure another shell. PowerShell is recommended." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Classes="accent"
                    Command="{Binding Settings.AddTerminalProfileCommand}"
                    Content="Add profile" />
              </Grid>

              <Grid x:Name="TerminalProfileLayout" Grid.Row="2" ColumnDefinitions="220,16,*">
                <Border x:Name="TerminalProfileListPanel" Classes="profileListPanel">
                  <ListBox
                      x:Name="TerminalProfileList"
                      Classes="profileList"
                      ItemsSource="{Binding Settings.TerminalProfiles}"
                      SelectedItem="{Binding Settings.SelectedTerminalProfile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="viewModels:TerminalProfileItemViewModel">
                        <StackPanel Spacing="5">
                          <TextBlock Classes="profileListName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="profileBadge default" IsVisible="{Binding IsDefault}">
                              <TextBlock Text="Default" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="secondary profileAvailability" Text="{Binding AvailabilityMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <Border x:Name="TerminalProfileEditorPanel" Grid.Column="2" Classes="profileEditor">
                  <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="16,14,16,12">
                      <TextBlock Classes="settingsSectionTitle" Text="Profile details" />
                      <TextBlock Classes="settingsSectionDescription" Margin="0,3,0,0" Text="Configure how this terminal starts." />
                    </StackPanel>

                    <ContentControl
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding Settings.SelectedTerminalProfile}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="viewModels:TerminalProfileItemViewModel">
                          <Grid RowDefinitions="*,Auto">
                            <ScrollViewer Classes="settingsContent">
                              <StackPanel Margin="16,0,16,16" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Classes="settingsLabel" Text="Name" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <Border Classes="profileBadge default" IsVisible="{Binding IsDefault}">
                                      <TextBlock Text="Default" />
                                    </Border>
                                  </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" />

                                <StackPanel>
                                  <TextBlock Classes="settingsLabel" Text="Executable" />
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBox
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Text="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="{DynamicResource SettingsBrowseButtonMargin}"
                                        Command="{Binding DataContext.Settings.BrowseTerminalProfileCommand, ElementName=SettingsRoot}"
                                        CommandParameter="{Binding}"
                                        Content="Browse..." />
                                  </Grid>
                                </StackPanel>

                                <StackPanel>
                                  <TextBlock Classes="settingsLabel" Text="Starting directory (optional)" />
                                  <TextBox Text="{Binding StartingDirectory, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel>
                                  <TextBlock Classes="settingsLabel" Text="Arguments (one per line)" />
                                  <TextBox MinHeight="96" AcceptsReturn="True" Text="{Binding ArgumentsText, Mode=TwoWay}" TextWrapping="NoWrap" />
                                </StackPanel>
                              </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" Classes="profileEditorFooter">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsAvailable}" Text="{Binding AvailabilityMessage}" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsUnavailable}" Text="{Binding AvailabilityMessage}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                  <Button
                                      IsVisible="{Binding CanSetDefault}"
                                      Command="{Binding DataContext.Settings.SetDefaultTerminalProfileCommand, ElementName=SettingsRoot}"
                                      CommandParameter="{Binding}"
                                      Content="Set default" />
                                  <Button
                                      Classes="danger"
                                      IsVisible="{Binding CanDelete}"
                                      Command="{Binding DataContext.Settings.DeleteTerminalProfileCommand, ElementName=SettingsRoot}"
                                      CommandParameter="{Binding}"
                                      Content="Delete" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>

                    <TextBlock
                        Grid.Row="1"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="secondary"
                        IsVisible="{Binding Settings.HasNoSelectedTerminalProfile}"
                        Text="Select a profile to edit it."
                        TextAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Classes="settingsTab" Header="Terminal">
            <ScrollViewer Margin="{DynamicResource SettingsContentMargin}" Classes="settingsContent">
              <StackPanel x:Name="TerminalGroup">
                <TextBlock Classes="settingsGroupTitle" Text="Terminal" />
                <StackPanel Spacing="{DynamicResource SettingsSectionSpacing}">
                  <Border Classes="settingsSection">
                    <StackPanel>
                      <TextBlock Classes="settingsSectionTitle" Text="Appearance" />
                      <TextBlock Classes="settingsSectionDescription" Text="Select an installed font, adjust its size, and customize text selection." />
                      <Grid ColumnDefinitions="*,16,180">
                        <StackPanel>
                          <TextBlock Classes="settingsLabel" Text="Font family" />
                          <ComboBox
                              x:Name="FontFamilyPicker"
                              Width="360"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Settings.SystemFontFamilies}"
                              SelectedIndex="{Binding Settings.SettingsTerminalFontFamilyIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Classes="settingsLabel" Text="Font size" />
                          <NumericUpDown Minimum="8" Maximum="32" ShowButtonSpinner="False" Value="{Binding Settings.SettingsTerminalFontSize, Mode=TwoWay}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="{DynamicResource SettingsNestedFieldMargin}">
                        <TextBlock Classes="settingsLabel" Text="Selection color" />
                        <ComboBox Width="{DynamicResource SettingsColorPickerWidth}" HorizontalAlignment="Left" ItemsSource="{Binding Settings.TerminalSelectionColors}" SelectedItem="{Binding Settings.SettingsTerminalSelectionColor, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TerminalSelectionColorOption">
                              <StackPanel Orientation="Horizontal">
                                <Border Width="{DynamicResource ColorSwatchSize}" Height="{DynamicResource ColorSwatchSize}" Margin="{DynamicResource ColorSwatchMargin}" VerticalAlignment="Center" Background="{Binding PreviewBrush}" BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusS}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="settingsSection">
                    <StackPanel>
                      <TextBlock Classes="settingsSectionTitle" Text="Cursor" />
                      <TextBlock Classes="settingsSectionDescription" Text="Control the cursor shape and animation." />
                      <Grid ColumnDefinitions="*,16,*">
                        <StackPanel>
                          <TextBlock Classes="settingsLabel" Text="Cursor style" />
                          <ComboBox ItemsSource="{Binding Settings.TerminalCursorStyles}" SelectedItem="{Binding Settings.SettingsTerminalCursorStyle, Mode=TwoWay}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" VerticalAlignment="Bottom" IsChecked="{Binding Settings.SettingsTerminalCursorBlink, Mode=TwoWay}" Content="Blink cursor" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Classes="settingsTab" Header="Data">
            <ScrollViewer Margin="{DynamicResource SettingsContentMargin}" Classes="settingsContent">
              <StackPanel x:Name="DataGroup">
                <TextBlock Classes="settingsGroupTitle" Text="Data" />
                <Border Classes="settingsSection">
                  <StackPanel>
                    <TextBlock Classes="settingsSectionTitle" Text="Session data" />
                    <TextBlock Classes="settingsSectionDescription" Text="Back up or transfer all saved sessions and folders using a versioned HyperTerm JSON archive." />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SettingsActionSpacing}">
                      <Button Command="{Binding Settings.ExportSessionsCommand}" Content="Export..." />
                      <Button Command="{Binding Settings.ImportSessionsCommand}" Content="Import..." />
                    </StackPanel>
                    <TextBlock Margin="{DynamicResource SettingsStatusMargin}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding Settings.HasSettingsDataStatus}" TextWrapping="Wrap" Text="{Binding Settings.SettingsDataStatus}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Classes="settingsTab" Header="Logs">
            <ScrollViewer Margin="{DynamicResource SettingsContentMargin}" Classes="settingsContent">
              <StackPanel x:Name="LogsGroup">
                <TextBlock Classes="settingsGroupTitle" Text="Logs" />
                <StackPanel Spacing="{DynamicResource SettingsSectionSpacing}">
                  <Border Classes="settingsSection">
                    <StackPanel>
                      <TextBlock Classes="settingsSectionTitle" Text="Diagnostics" />
                      <TextBlock Classes="settingsSectionDescription" Text="Capture local diagnostic events and unexpected failures. Terminal input, output, passwords, and keys are never recorded." />
                      <CheckBox IsChecked="{Binding Settings.SettingsCaptureLogs, Mode=TwoWay}" Content="Capture diagnostic logs" />
                      <TextBlock Margin="0,8,0,0" Classes="secondary" Text="Up to 7 files of 5 MB are retained locally." />
                    </StackPanel>
                  </Border>
                  <Border Padding="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusM}" IsVisible="{Binding Settings.HasPreviousRunCrash}">
                    <TextBlock Foreground="{DynamicResource WarningBrush}" Text="The previous HyperTerm run appears to have ended unexpectedly." TextWrapping="Wrap" />
                  </Border>
                  <TextBox MinHeight="220" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" IsReadOnly="True" Text="{Binding Settings.LogContent}" TextWrapping="NoWrap" VerticalContentAlignment="Top" PlaceholderText="No logs captured yet." />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding Settings.LogStatus}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Command="{Binding Settings.RefreshLogsCommand}" Content="Refresh" />
                      <Button Command="{Binding Settings.CopyLogsCommand}" Content="Copy" />
                      <Button Command="{Binding Settings.OpenLogsFolderCommand}" Content="Open folder" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,0,0,12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Settings.SettingsError}" />
        <Border Grid.Row="3" Padding="{DynamicResource SettingsFooterPadding}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding Settings.CancelSettingsCommand}" Content="Cancel" />
            <Button Classes="accent" Command="{Binding Settings.SaveSettingsCommand}" Content="Save" IsDefault="{Binding Settings.IsSettingsOpen}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Panel>
</UserControl>
