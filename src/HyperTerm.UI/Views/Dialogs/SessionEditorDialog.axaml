<UserControl
    x:Class="HyperTerm.UI.Views.Dialogs.SessionEditorDialog"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:HyperTerm.UI.ViewModels"
    IsVisible="{Binding SessionEditor.IsEditorOpen}">
  <Panel>
      <Border Background="{DynamicResource OverlayBrush}" />
      <Border
          Width="560"
          Padding="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SessionEditor.EditorTitle}" />
          <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*,16,160">
            <StackPanel>
              <TextBlock Margin="0,0,0,5" Text="Name" />
              <TextBox
                  x:Name="SessionNameEditor"
                  AutomationProperties.AutomationId="SessionNameEditor"
                  Text="{Binding SessionEditor.EditorName, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,5" Text="Port" />
              <NumericUpDown
                  Minimum="1"
                  Maximum="65535"
                  ShowButtonSpinner="False"
                  Value="{Binding SessionEditor.EditorPort, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,5" Text="Host" />
            <TextBox Text="{Binding SessionEditor.EditorHost, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,5" Text="Username" />
            <TextBox Text="{Binding SessionEditor.EditorUsername, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,5" Text="Notes" />
            <TextBox
                MinHeight="72"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Text="{Binding SessionEditor.EditorNotes, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock
              Grid.Row="5"
              Margin="0,10,0,0"
              Foreground="{DynamicResource DangerBrush}"
              TextWrapping="Wrap"
              Text="{Binding SessionEditor.EditorError}" />
          <StackPanel Grid.Row="6" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding SessionEditor.CancelEditorCommand}" Content="Cancel" />
            <Button
                Classes="accent"
                Command="{Binding SessionEditor.SaveSessionCommand}"
                Content="Save"
                IsDefault="{Binding SessionEditor.IsEditorOpen}" />
          </StackPanel>
        </Grid>
      </Border>
    </Panel>
</UserControl>
