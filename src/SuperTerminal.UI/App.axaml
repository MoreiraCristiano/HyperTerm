<Application
    x:Class="SuperTerminal.UI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#181A1F" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202329" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#252830" />
    <SolidColorBrush x:Key="BorderBrush" Color="#343842" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E05260" />
  </Application.Resources>
</Application>
